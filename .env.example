# Required: obtain from https://console.anosys.ai/collect/integrationoptions
ANOSYS_API_KEY=your_anosys_api_key_here

# Required when using anosys-sdk-openai or anosys-sdk-openai-agents
OPENAI_API_KEY=your_openai_api_key_here

# Required when using anosys-sdk-anthropic or anosys-sdk-claude-agents
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: client-side encryption passphrase for sensitive fields
# ANOSYS_ENCRYPTION_KEY=your_encryption_passphrase_here

# Optional overrides (defaults shown)
# ANOSYS_API_URL=https://www.anosys.ai
# ANOSYS_RESOLVER_URL=https://console.anosys.ai/api/resolveapikeys
